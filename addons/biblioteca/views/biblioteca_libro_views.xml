<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_biblioteca_libro_form" model="ir.ui.view">
        <field name="name">biblioteca.libro.form</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="autor"/>
                        <field name="anio_publicacion"/>
                        <field name="paginas"/>
                        <field name="disponible"/>
                        <field name="precio_costo"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_biblioteca_libro_list" model="ir.ui.view">
        <field name="name">biblioteca.libro.list</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="autor"/>
                <field name="anio_publicacion"/>
                <field name="disponible"/>
            </list>
        </field>
    </record>

    <record id="view_biblioteca_libro_kanban" model="ir.ui.view">
        <field name="name">biblioteca.libro.kanban</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="autor"/>
                <field name="disponible"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div>Autor: <field name="autor"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_biblioteca_libro" model="ir.actions.act_window">
        <field name="name">Libros</field>
        <field name="res_model">biblioteca.libro</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="menu_biblioteca_root" name="Biblioteca"/>
    <menuitem id="menu_biblioteca_libros" name="Libros" parent="menu_biblioteca_root" action="action_biblioteca_libro"/>
</odoo>
