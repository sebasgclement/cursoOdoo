<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NIVEL 2: usuarios internos solo ven los libros disponibles -->
    <record id="rule_libro_disponibles" model="ir.rule">
        <field name="name">Libros: solo disponibles</field>
        <field name="model_id" ref="model_biblioteca_libro"/>
        <field name="domain_force">[('disponible', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- El admin tambien esta en base.group_user, asi que la regla de arriba
         lo filtraria a el tambien. Las reglas de distintos grupos se suman (OR):
         esta le devuelve al admin todas las filas. -->
    <record id="rule_libro_admin_todos" model="ir.rule">
        <field name="name">Libros: admin ve todos</field>
        <field name="model_id" ref="model_biblioteca_libro"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
