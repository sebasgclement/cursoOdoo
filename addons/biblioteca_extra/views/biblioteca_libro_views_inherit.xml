<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia del formulario: agrega "resumen" despues de "autor" -->
    <record id="view_biblioteca_libro_form_inherit" model="ir.ui.view">
        <field name="name">biblioteca.libro.form.inherit</field>
        <field name="model">biblioteca.libro</field>
        <field name="inherit_id" ref="biblioteca.view_biblioteca_libro_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='autor']" position="after">
                <field name="resumen"/>
            </xpath>
        </field>
    </record>

    <!-- Herencia de la lista (ejercicio de Marcos): agrega la columna "paginas" -->
    <record id="view_biblioteca_libro_list_inherit" model="ir.ui.view">
        <field name="name">biblioteca.libro.list.inherit</field>
        <field name="model">biblioteca.libro</field>
        <field name="inherit_id" ref="biblioteca.view_biblioteca_libro_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='autor']" position="after">
                <field name="paginas"/>
            </xpath>
        </field>
    </record>
</odoo>
